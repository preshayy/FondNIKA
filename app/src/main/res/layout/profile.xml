<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F7F2"
    android:padding="20dp">

    <!-- Кнопка выхода внизу экрана -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnLogout"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_circle_green"
        android:text="Выйти из аккаунта"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="16sp" />

    <!-- Основное содержимое сверху -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/btnLogout"
        android:orientation="vertical">

        <!-- Кнопка "Назад" -->
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Назад"
            android:src="?attr/homeAsUpIndicator"
            app:tint="@color/light_text" />

        <!-- Аватар пользователя -->
        <ImageView
            android:id="@+id/ivAvatar"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_profile_card"
            android:padding="20dp"
            android:src="@drawable/ic_person"
            app:tint="#4A5D4E" />

        <TextView
            android:id="@+id/tvUserName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:text="Ника"
            android:textColor="@color/black"
            android:textSize="16sp" />

        <!-- Email пользователя -->
        <TextView
            android:id="@+id/tvUserEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="volunteer@nika-fond.ru"
            android:textColor="@color/light_text"
            android:textSize="16sp" />

        <!-- Заголовок секции с питомцами -->
        <TextView
            android:id="@+id/tvPetsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Питомцы под опекой"
            android:textColor="#1C1B1F"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- Карточка с поддерживаемыми питомцами -->
        <LinearLayout
            android:id="@+id/cardSupportedPets"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_log_input"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Питомец 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Коржик, 3 года"
                        android:textColor="#1C1B1F"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ежемесячная опека"
                        android:textColor="#556B5D"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chat_input"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="Активна"
                    android:textColor="@color/status_green"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Разделительная линия -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="12dp"
                android:background="#DCD8CE" />

            <!-- Питомец 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Буся, 2 года"
                        android:textColor="#1C1B1F"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Помощь с кормом"
                        android:textColor="#556B5D"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chat_input"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="Активна"
                    android:textColor="@color/status_green"
                    android:textSize="12sp" />
            </LinearLayout>

        </LinearLayout>

        <!-- Кнопка перехода на сайт фонда -->
        <LinearLayout
            android:id="@+id/btnOpenWebsite"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_profile_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">


            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="Перейти на сайт фонда НИКА"
                android:textColor="#1C1B1F"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="↗"
                android:textColor="#2A4D38"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

</RelativeLayout>
